// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// One row per shop that has ever used StoreSweep. Lifecycle fields are
/// maintained by webhooks (app/uninstalled, app/scopes_update).
model Shop {
  shop          String    @id
  firstSeenAt   DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  uninstalledAt DateTime?
  lastScanAt    DateTime?
  scanCount     Int       @default(0)
  cleanCount    Int       @default(0)
  scans         Scan[]
  cleanOperations CleanOperation[]
  auditEvents   AuditEvent[]
  ignoredFindings IgnoredFinding[]
}

/// One completed scan of the store's published theme.
model Scan {
  id           String   @id @default(cuid())
  shop         String
  themeId      String
  themeName    String?
  status       String   @default("completed") // completed | failed
  fileCount    Int      @default(0)
  findingCount Int      @default(0)
  durationMs   Int?
  /// JSON map of filename -> sha256 checksum captured at scan time; used to
  /// detect theme drift between a scan and a later cleaning run.
  fileChecksums String?
  createdAt    DateTime @default(now())
  shopRef      Shop?    @relation(fields: [shop], references: [shop])
  findings     ScanFinding[]
  cleanOperations CleanOperation[]

  @@index([shop, createdAt])
}

/// A single leftover-code match found during a scan.
model ScanFinding {
  id          String @id @default(cuid())
  scanId      String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingKey  String // stable key derived from filename + offsets
  filename    String
  appName     String
  category    String?
  confidence  String?
  matchedCode String
  startLine   Int
  endLine     Int

  @@index([scanId])
  @@index([findingKey])
}

/// One executed cleaning run. Backup filenames allow one-click restore.
model CleanOperation {
  id           String   @id @default(cuid())
  shop         String
  scanId       String?
  scan         Scan?    @relation(fields: [scanId], references: [id])
  status       String   @default("completed") // completed | failed | restored
  removedCount Int      @default(0)
  filesChanged Int      @default(0)
  /// JSON array of [{ originalFilename, backupFilename, checksumBefore }]
  backups      String?
  restoredAt   DateTime?
  createdAt    DateTime @default(now())
  shopRef      Shop?    @relation(fields: [shop], references: [shop])

  @@index([shop, createdAt])
}

/// Append-only trail of every consequential action StoreSweep performs.
model AuditEvent {
  id        String   @id @default(cuid())
  shop      String
  action    String // scan.completed, clean.started, clean.completed, theme.restored, ...
  detail    String? // JSON payload
  createdAt DateTime @default(now())
  shopRef   Shop?    @relation(fields: [shop], references: [shop])

  @@index([shop, createdAt])
}

/// Matches a merchant marked as intentional so scans stop surfacing them.
/// Identity is (filename, appName, hash of the exact matched code), so a
/// finding stays ignored across unrelated edits to the file.
model IgnoredFinding {
  id        String   @id @default(cuid())
  shop      String
  filename  String
  appName   String
  codeHash  String
  createdAt DateTime @default(now())
  shopRef   Shop?    @relation(fields: [shop], references: [shop])

  @@unique([shop, filename, appName, codeHash])
  @@index([shop])
}
